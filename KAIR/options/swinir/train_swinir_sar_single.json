{
  "task": "swinir_sar_single" // single-frame one-bit SAR restoration baseline
  , "model": "plain"
  , "gpu_ids": [0,1]
  , "dist": false

  , "n_channels": 1

  , "path": {
    "root": "denoising"
    , "pretrained_netG": null
    , "pretrained_netE": null
  }

  , "datasets": {
    "train": {
      "name": "sar_single_train"
      , "dataset_type": "sar_1bit"
      , "dataroot_L": "/data/cjz/SAR_Transformer/dataset_range_2dsft/range_2d_sft_qh2p5_ql1p5_s1_fr0p9_fa0p5_phi0_lp0p99_hp99p9_roi600_eb64/LQ" // 单比特 SAR LQ 根目录
      , "dataroot_H": "/data/cjz/SAR_Transformer/dataset_range_2dsft/range_2d_sft_qh2p5_ql1p5_s1_fr0p9_fa0p5_phi0_lp0p99_hp99p9_roi600_eb64/GT" // 全精度 SAR GT 根目录
      , "split_file": "/data/cjz/SAR_Transformer/docs/splits/sar_single_seed42/train.txt" // seed 42，80% sequence 用于训练
      , "H_size": 128
      , "dataloader_shuffle": true
      , "dataloader_num_workers": 8
      , "dataloader_batch_size": 2 // 双卡各处理 1 张 patch，降低训练激活显存
    }
    , "test": {
      "name": "sar_single_test"
      , "dataset_type": "sar_1bit"
      , "dataroot_L": "/data/cjz/SAR_Transformer/dataset_range_2dsft/range_2d_sft_qh2p5_ql1p5_s1_fr0p9_fa0p5_phi0_lp0p99_hp99p9_roi600_eb64/LQ" // 单比特 SAR LQ 根目录
      , "dataroot_H": "/data/cjz/SAR_Transformer/dataset_range_2dsft/range_2d_sft_qh2p5_ql1p5_s1_fr0p9_fa0p5_phi0_lp0p99_hp99p9_roi600_eb64/GT" // 全精度 SAR GT 根目录
      , "split_file": "/data/cjz/SAR_Transformer/docs/splits/sar_single_seed42/test.txt" // seed 42，剩余 20% sequence 用于测试
      , "H_size": 512 // 测试使用完整 512x512 图像，不裁 patch
    }
  }

  , "netG": {
    "net_type": "swinir"
    , "upscale": 1
    , "in_chans": 1
    , "img_size": 128
    , "window_size": 8
    , "img_range": 1.0
    , "depths": [6, 6, 6, 6, 6, 6]
    , "embed_dim": 180
    , "num_heads": [6, 6, 6, 6, 6, 6]
    , "mlp_ratio": 2
    , "upsampler": null
    , "resi_connection": "1conv"

    , "init_type": "default"
    , "init_bn_type": "uniform"
    , "init_gain": 0.2
  }

  , "train": {
    "manual_seed": 42 // 固定网络初始化、数据打乱和 paired crop 的随机种子
    , "G_lossfn_type": "charbonnier"
    , "G_lossfn_weight": 1.0
    , "G_charbonnier_eps": 1e-9

    , "E_decay": 0

    , "G_optimizer_type": "adam"
    , "G_optimizer_lr": 1e-4 // 小 batch 的初始学习率，后续根据收敛情况评估
    , "G_optimizer_betas": [0.9, 0.999]
    , "G_optimizer_wd": 0
    , "G_optimizer_clipgrad": null
    , "G_optimizer_reuse": true

    , "G_scheduler_type": "MultiStepLR"
    , "G_scheduler_milestones": [3200000, 4800000, 5600000, 6000000, 6400000] // batch 8→2，按相同样本量将步数乘 4
    , "G_scheduler_gamma": 0.5

    , "G_regularizer_orthstep": null
    , "G_regularizer_clipstep": null

    , "G_param_strict": true
    , "E_param_strict": true

    , "checkpoint_test": 20000
    , "checkpoint_save": 20000
    , "checkpoint_print": 800
  }
}
